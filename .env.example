# RelayForge MCP local HTTP endpoint
RELAYFORGE_HTTP_HOST=127.0.0.1
RELAYFORGE_HTTP_PORT=3334
RELAYFORGE_MCP_PATH=/mcp

# Optional Bearer token. Recommended when the endpoint is exposed outside localhost.
RELAYFORGE_HTTP_TOKEN=

# Runtime behavior
RELAYFORGE_OFFLINE_MODE=1
RELAYFORGE_DISABLE_TELEMETRY=1
RELAYFORGE_PUBLIC_READONLY=0

# Fixed public URL shown by the launcher, for example:
# https://mcp.example.com/mcp
RELAYFORGE_PUBLIC_URL=

# Optional Cloudflare named tunnel token.
# Keep this only in your local .env; never commit it.
CLOUDFLARE_TUNNEL_TOKEN=
